# Copia este archivo como .env y ajusta los valores. Nunca subas .env a Git.
# Todos los valores de aquí son ficticios o de desarrollo local.

# Entorno de ejecución: development | test | production
APP_ENV=development

# PostgreSQL local de docker-compose.yml (credenciales solo de desarrollo).
DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel
# Base usada por las pruebas de integración (se borra en cada ejecución).
TEST_DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel_test

# Subida y procesamiento de PDF.
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=500
# Carpeta para los PDF subidos (por defecto backend/storage). Nunca se sirve por HTTP.
# STORAGE_DIR=/ruta/absoluta/a/storage

# Fragmentación en caracteres. CHUNK_OVERLAP debe ser menor que CHUNK_SIZE.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embeddings: "openai" (real, de pago) o "fake" (local y determinista, sin clave; para
# probar la aplicación sin gastar). Ver docs/decisions/0001-proveedor-embeddings.md.
EMBEDDINGS_PROVIDER=openai
# Crea tu clave en https://platform.openai.com/api-keys y configura un límite de gasto.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=100
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3

# Búsqueda.
MAX_QUERY_CHARS=1000
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_TOP_K=20
# Similitud coseno mínima (0-1) para aceptar un resultado vectorial. Valor inicial a calibrar.
RETRIEVAL_MIN_SCORE=0.25

# LLM que redacta las respuestas: "openai" (real) o "fake" (local, sin clave). Usa la misma
# OPENAI_API_KEY. Ver docs/decisions/0002-proveedor-llm.md.
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Solo para estimar el costo en los logs (USD por millón de tokens).
LLM_INPUT_PRICE_PER_MTOK=0.10
LLM_OUTPUT_PRICE_PER_MTOK=0.50
# Máximo de caracteres de fragmentos enviados al LLM por pregunta.
RAG_MAX_CONTEXT_CHARS=8000

# Resumen automático de cada documento (ver docs/decisions/0003-resumen-de-documentos.md).
# Caracteres máximos enviados al LLM para resumir y longitud máxima del resumen guardado.
SUMMARY_MAX_INPUT_CHARS=12000
SUMMARY_MAX_CHARS=1500
